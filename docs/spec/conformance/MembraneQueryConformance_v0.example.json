{
  "schema": "MembraneQueryConformance",
  "version": "0",
  "description": "Conformance fixtures for the newhope-membrane-query Lattice adapter. Each test case exercises one or more of the CQ-0x checks defined in docs/Lattice_Membrane_Query_Adapter.md §9.",
  "test_cases": [
    {
      "id": "CQ-01",
      "description": "Dry-run is side-effect-free and deterministic: identical inputs produce identical DryRunRoute.",
      "input": {
        "adapter": "newhope-membrane-query",
        "adapter_version": "0.1.0",
        "operation": "query.message",
        "query_id": "00000000-0000-0000-0000-000000000001",
        "dry_run": true,
        "filter": {
          "concept": "Message",
          "predicates": [{"field": "visibility", "op": "eq", "value": "public"}],
          "limit": 10,
          "cursor": null
        },
        "policy_context": {
          "tenant": "commons",
          "community": "news:world",
          "ruleset_ref": "hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "provenance": {
          "requester_id": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK",
          "requester_kind": "agent",
          "request_ts": "2026-01-01T00:00:00Z",
          "purpose_code": "search",
          "session_ref": null
        }
      },
      "expected_output": {
        "adapter": "newhope-membrane-query",
        "query_id": "00000000-0000-0000-0000-000000000001",
        "dry_run": true,
        "route": {
          "eligible": true,
          "receptors": [
            {
              "receptor_id": "did:key:z6MkMessageQueryReceptor",
              "receptor_kind": "MessageQueryReceptor",
              "membrane_gate": "did:key:z6MkDefaultMembraneGate",
              "policy_match": true
            }
          ],
          "denial_reasons": []
        },
        "evidence": {
          "policy_ref": "hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "ruleset_ref": "hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "matching_labels": ["public"],
          "provenance_chain": ["hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
        },
        "membrane_decision": {
          "decision": "dry-run",
          "rationale": "Dry-run evaluation only; no live data accessed.",
          "redacted_fields": [],
          "required_signatures": []
        },
        "ts": "2026-01-01T00:00:01Z"
      }
    },
