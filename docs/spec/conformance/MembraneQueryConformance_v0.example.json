    {
      "id": "CQ-05",
      "description": "Every request (dry-run or live) produces a MembraneDecision carrier in the audit log.",
      "notes": "This is a behavioural assertion verified by inspecting the adapter audit log after the request in CQ-01 is processed. The audit carrier must have decision='dry-run' and reference query_id 00000000-0000-0000-0000-000000000001.",
      "expected_audit_carrier": {
        "carrier_version": "1",
        "protocol_ref": "hash://blake3/<MembraneDecision_v0-protocol-hash>",
        "signal": {
          "type": "MembraneDecisionRecorded",
          "ts": "2026-01-01T00:00:01Z",
          "id": "hash://blake3/<audit-signal-hash>",
          "parents": [],
          "thread_root": null,
          "derived_from": ["hash://blake3/<query-carrier-hash>"]
        },
        "payload": {
          "decision": "dry-run",
          "query_ref": "00000000-0000-0000-0000-000000000001",
          "policy_ref": "hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "rationale": "Dry-run evaluation only; no live data accessed.",
          "redacted_fields": [],
          "required_signatures": [],
          "audit_trail": []
        },
        "provenance": {
          "emitter": {
            "kind": "service",
            "id": "did:key:z6MkDefaultMembraneGate",
            "device_attestation": null
          },
          "signatures": [
            {
              "alg": "ed25519",
              "sig": "base64...",
              "covers": "hash://blake3/<canonical-carrier-hash>"
            }
          ],
          "inputs": ["hash://blake3/<query-carrier-hash>"],
          "transforms": []
        },
        "policy_context": {
          "tenant": "commons",
          "community": "news:world",
          "ruleset_ref": "hash://blake3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "labels": ["dry-run", "audit"]
        }
      }
    },
